FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /source
COPY src/Glimpse.RoomProtocol/Glimpse.RoomProtocol.csproj src/Glimpse.RoomProtocol/
COPY src/Glimpse.Signaling/Glimpse.Signaling.csproj src/Glimpse.Signaling/
RUN dotnet restore src/Glimpse.Signaling/Glimpse.Signaling.csproj
COPY src/Glimpse.RoomProtocol/ src/Glimpse.RoomProtocol/
COPY src/Glimpse.Signaling/ src/Glimpse.Signaling/
RUN dotnet publish src/Glimpse.Signaling/Glimpse.Signaling.csproj -c Release --no-restore -o /app

FROM mcr.microsoft.com/dotnet/aspnet:10.0
WORKDIR /app
ENV ASPNETCORE_HTTP_PORTS=8080
COPY --from=build /app .
USER $APP_UID
EXPOSE 8080
ENTRYPOINT ["dotnet", "Glimpse.Signaling.dll"]
