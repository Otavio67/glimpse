<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <Version>0.2.11-preview</Version>
    <ApplicationIcon>Assets\glimpse.ico</ApplicationIcon>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Glimpse.RoomProtocol\Glimpse.RoomProtocol.csproj" />
    <PackageReference Include="SIPSorcery" Version="10.0.17" />
    <PackageReference Include="SharpDX.Direct3D11" Version="4.2.0" />
  </ItemGroup>
  <ItemGroup><Resource Include="Assets\glimpse.ico" /><Resource Include="Assets\glimpse.png" /><Resource Include="Assets\Avatars\*.png" /></ItemGroup>
  <ItemGroup><InternalsVisibleTo Include="Glimpse.NativeRooms" /></ItemGroup>
</Project>
