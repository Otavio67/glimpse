<Window x:Class="Glimpse.Views.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:r="clr-namespace:Glimpse.Resources" Title="{x:Static r:Strings.Title}" Width="1180" Height="790" MinWidth="880" MinHeight="680" Background="#101820" Foreground="#EAF2F5" WindowStartupLocation="CenterScreen">
  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="76"/><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions>
    <Border Grid.Column="0" Background="#0A1118"><StackPanel Margin="12,20"><Border Background="#7CE0C3" CornerRadius="17" Width="52" Height="52"><TextBlock Text="G" Foreground="#10251F" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="{x:Static r:Strings.Local}" Foreground="#77929D" HorizontalAlignment="Center" Margin="0,18,0,0" FontSize="10"/></StackPanel></Border>
    <Grid Grid.Column="1" Margin="24,22,24,20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <DockPanel><StackPanel><TextBlock Text="Glimpse" FontSize="27" FontWeight="Bold"/><TextBlock Text="{x:Static r:Strings.Tagline}" Foreground="#90AAB4" Margin="0,2,0,14"/></StackPanel><TextBlock Text="{Binding Status}" Foreground="#7CE0C3" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10" TextWrapping="Wrap" MaxWidth="350" AutomationProperties.Name="Connection status"/></DockPanel>
      <Border Grid.Row="1" Background="#080E14" CornerRadius="12" ClipToBounds="True"><Grid><Image Source="{Binding Frame}" Stretch="Uniform" AutomationProperties.Name="Remote shared screen"/><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding WaitingVisibility}"><TextBlock Text="◉" FontSize="54" Foreground="#466672" HorizontalAlignment="Center"/><TextBlock Text="{x:Static r:Strings.Waiting}" Foreground="#B2C6CC" FontSize="16" Margin="0,12"/></StackPanel></Grid></Border>
      <Grid Grid.Row="2" Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel Margin="0,0,8,0"><TextBlock Text="{x:Static r:Strings.YourText}" FontSize="10" FontWeight="Bold" Foreground="#8FAAB4"/><TextBox Text="{Binding LocalText, Mode=OneWay}" IsReadOnly="True" Height="65" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Your connection text"/></StackPanel><StackPanel Grid.Column="1" Margin="8,0,0,0"><TextBlock Text="{x:Static r:Strings.OtherText}" FontSize="10" FontWeight="Bold" Foreground="#8FAAB4"/><TextBox Text="{Binding RemoteText, UpdateSourceTrigger=PropertyChanged}" Height="65" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Other person's connection text"/></StackPanel></Grid>
      <WrapPanel Grid.Row="3" Margin="0,16,0,0"><Button Content="{x:Static r:Strings.CreateOffer}" Command="{Binding CreateOfferCommand}" ToolTip="Host: create an offer" AutomationProperties.Name="Create offer"/><Button Content="{x:Static r:Strings.CreateAnswer}" Command="{Binding CreateAnswerCommand}" ToolTip="Guest: paste the offer and create an answer" AutomationProperties.Name="Create answer"/><Button Content="{x:Static r:Strings.ApplyAnswer}" Command="{Binding ApplyAnswerCommand}" ToolTip="Host: paste the answer" AutomationProperties.Name="Apply answer"/><Button Content="{x:Static r:Strings.Copy}" Command="{Binding CopyCommand}" ToolTip="Copy your connection text" AutomationProperties.Name="Copy connection text"/><Button Content="{x:Static r:Strings.Share}" Command="{Binding ShareCommand}" Background="#58BC9E" Foreground="#10251F" ToolTip="Choose a display or window" AutomationProperties.Name="Share screen"/><Button Content="{x:Static r:Strings.Stop}" Command="{Binding StopCommand}" ToolTip="Stop sharing without disconnecting" AutomationProperties.Name="Stop sharing"/><Button Content="{x:Static r:Strings.Disconnect}" Command="{Binding DisconnectCommand}" ToolTip="End the connection" AutomationProperties.Name="Disconnect"/></WrapPanel>
    </Grid>
    <Border Grid.Column="2" Background="#17232D"><StackPanel Margin="18,27"><TextBlock Text="{x:Static r:Strings.Session}" Foreground="#8DA6AF" FontSize="11" FontWeight="Bold"/><TextBlock Text="{x:Static r:Strings.PrivateLan}" FontSize="18" FontWeight="SemiBold" Margin="0,20,0,5"/><TextBlock Text="{x:Static r:Strings.SessionDescription}" Foreground="#A1B7BE" TextWrapping="Wrap" LineHeight="20"/><Separator Margin="0,22" Background="#344750"/><TextBlock Text="{x:Static r:Strings.Capture}" Foreground="#8DA6AF" FontSize="11" FontWeight="Bold"/><TextBlock Text="720p · 30 fps" Margin="0,12,0,5"/><TextBlock Text="{x:Static r:Strings.PickerDescription}" Foreground="#A1B7BE" TextWrapping="Wrap" LineHeight="20"/></StackPanel></Border>
  </Grid>
</Window>

