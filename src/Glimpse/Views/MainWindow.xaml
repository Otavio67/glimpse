<Window x:Class="Glimpse.Views.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:r="clr-namespace:Glimpse.Resources" Title="Glimpse — compartilhamento" Icon="/Assets/glimpse.ico" Width="1390" Height="880" MinWidth="0" MinHeight="0" Background="#111521" Foreground="#EEF1FA" WindowStartupLocation="Manual" FontFamily="Segoe UI">
  <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Focusable="False">
  <Grid MinWidth="1000" MinHeight="700">
    <Grid.ColumnDefinitions><ColumnDefinition Width="76"/><ColumnDefinition Width="205"/><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions>
    <!-- The rail and the session navigation are descriptive in this LAN milestone. -->
    <Border Grid.Column="0" Background="#0B0E16" BorderBrush="#222838" BorderThickness="0,0,1,0">
      <Grid><StackPanel Margin="12,20,12,0"><Image Source="/Assets/glimpse.png" Width="50" Height="50" AutomationProperties.Name="Logo Glimpse"/><Border Width="29" Height="1" Background="#303646" Margin="0,19,0,19"/><Grid><Border Width="48" Height="48" Background="#232B3D" CornerRadius="15"/><TextBlock Text="◈" Foreground="#B7A9FF" FontSize="25" HorizontalAlignment="Center" VerticalAlignment="Center"/><Border Background="#B8A8FF" Width="4" Height="27" CornerRadius="2" HorizontalAlignment="Left" Margin="-12,0,0,0"/></Grid></StackPanel><TextBlock Text="G" Foreground="#596479" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,22"/></Grid>
    </Border>
    <Border Grid.Column="1" Background="#171C2A" BorderBrush="#292F40" BorderThickness="0,0,1,0">
      <Grid><Grid.RowDefinitions><RowDefinition Height="72"/><RowDefinition Height="*"/><RowDefinition Height="70"/></Grid.RowDefinitions>
        <StackPanel Margin="20,17,12,0"><TextBlock Text="GLIMPSE" FontSize="16" FontWeight="Bold" Foreground="#F2F2FF"/><TextBlock Text="SEU ESPAÇO PARA ESTAR JUNTO" FontSize="9" FontWeight="Bold" Foreground="#78839B" Margin="0,3,0,0"/></StackPanel>
        <StackPanel Grid.Row="1" Margin="12,12,12,0"><TextBlock Text="SEU ESPAÇO" FontSize="10" FontWeight="Bold" Foreground="#778198" Margin="9,0,0,13"/><Border Background="#303448" CornerRadius="8" Padding="11,10"><DockPanel><Ellipse DockPanel.Dock="Right" Width="7" Height="7" Fill="#69DAB8" VerticalAlignment="Center"/><TextBlock Text="◈   Sua sala" FontWeight="SemiBold" Foreground="#F4F1FF"/></DockPanel></Border><TextBlock Text="CONEXÃO" FontSize="10" FontWeight="Bold" Foreground="#778198" Margin="9,28,0,12"/><TextBlock Text="{Binding ConnectionLabel}" Foreground="#A9B4C9" Margin="10,0,0,10"/><TextBlock Text="◉   Compartilhar tela" Foreground="#A9B4C9" Margin="10,0"/><Border Background="#202638" CornerRadius="10" Padding="12" Margin="0,34,0,0"><StackPanel><TextBlock Text="MAIS PERTO" FontSize="9" FontWeight="Bold" Foreground="#B5A7FF"/><TextBlock Text="Compartilhe sua tela com quem você gosta." Foreground="#C2CBDD" TextWrapping="Wrap" Margin="0,8,0,0" LineHeight="18" FontSize="12"/></StackPanel></Border></StackPanel>
        <Border Grid.Row="2" Background="#121725" Padding="15,0"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Border Width="36" Height="36" Background="#524B8D" CornerRadius="13"><TextBlock Text="G" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/></Border><StackPanel Margin="10,0,0,0"><TextBlock Text="Você" FontWeight="SemiBold" FontSize="12"/><TextBlock Text="Prévia local" Foreground="#8E9BB0" FontSize="11" Margin="0,3,0,0"/></StackPanel></StackPanel></Border>
      </Grid>
    </Border>
    <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="72"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Border BorderBrush="#2B3141" BorderThickness="0,0,0,1" Padding="24,0"><DockPanel VerticalAlignment="Center"><Border DockPanel.Dock="Right" Background="#252B39" CornerRadius="13" Padding="11,5"><TextBlock Text="GLIMPSE" FontWeight="Bold" FontSize="10" Foreground="#B9AFFF"/></Border><StackPanel Orientation="Horizontal"><TextBlock Text="◈" Foreground="#B4A4FF" FontSize="21" VerticalAlignment="Center"/><StackPanel Margin="12,0,0,0"><TextBlock Text="{Binding RoomTitle}" FontWeight="Bold" FontSize="15"/><TextBlock Text="Um espaço para compartilhar sua tela" Foreground="#909BB1" FontSize="11" Margin="0,3,0,0"/></StackPanel></StackPanel></DockPanel></Border>
      <Grid Grid.Row="1" Margin="24,22,24,0"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Background="#090C13" CornerRadius="15" ClipToBounds="True" BorderBrush="#30374B" BorderThickness="1"><Grid><Image Source="{Binding Frame}" Stretch="Uniform" AutomationProperties.Name="Tela compartilhada pelo amigo"/><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding WaitingVisibility}"><Border Width="88" Height="88" Background="#20263A" CornerRadius="29" HorizontalAlignment="Center"><Grid><Ellipse Width="39" Height="39" Stroke="#AA9AFD" StrokeThickness="2"/><Ellipse Width="10" Height="10" Fill="#AA9AFD"/></Grid></Border><TextBlock Text="Tudo fica melhor quando estamos juntos." FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,23,0,0"/><TextBlock Text="Crie uma sala ou entre com o código de um amigo." Foreground="#939FB5" FontSize="13" HorizontalAlignment="Center" Margin="0,9,0,0"/></StackPanel><Border Background="#222838" CornerRadius="6" Padding="9,5" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="16"><TextBlock Text="◉  COMPARTILHAMENTO" FontSize="10" FontWeight="Bold" Foreground="#B9C2D5"/></Border></Grid></Border>
        <Border Grid.Row="1" Background="#1A2030" CornerRadius="12" BorderBrush="#2E3749" BorderThickness="1" Padding="16" Margin="0,16,0,0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DockPanel Margin="0,0,0,10"><TextBlock Text="SALA DE COMPARTILHAMENTO" FontWeight="Bold" FontSize="10" Foreground="#9DABBE"/><TextBlock Text="{Binding ParticipantsText}" HorizontalAlignment="Right" Foreground="#AAB4C8" FontSize="11"/></DockPanel><Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel Margin="0,0,7,0"><TextBlock Text="CÓDIGO DA SUA SALA" FontSize="10" Foreground="#A8B2C5" Margin="0,0,0,6"/><TextBox Text="{Binding LocalText, Mode=OneWay}" IsReadOnly="True" Height="56" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Código da sua sala"/></StackPanel><StackPanel Grid.Column="1" Margin="7,0,0,0"><TextBlock Text="CÓDIGO DA SALA DO SEU AMIGO" FontSize="10" Foreground="#A8B2C5" Margin="0,0,0,6"/><TextBox Text="{Binding RemoteText, UpdateSourceTrigger=PropertyChanged}" Height="56" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Digite o código da sala"/></StackPanel></Grid><StackPanel Grid.Row="2"><StackPanel IsEnabled="{Binding CanConfigureRoom}"><CheckBox Content="Hospedar no próprio PC" IsChecked="{Binding NativeMode}" Foreground="#CFD9E6" Margin="0,12,0,6"/><WrapPanel><StackPanel Width="240" Margin="0,0,12,0"><TextBlock Text="SEU IPv4 PÚBLICO (OPCIONAL)" FontSize="10" Foreground="#A8B2C5" Margin="0,0,0,5"/><TextBox Text="{Binding HostAddress, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="IPv4 público do anfitrião" ToolTip="Deixe em branco para tentar descobrir pelo roteador. Usado apenas ao criar uma sala."/></StackPanel><StackPanel Width="85"><TextBlock Text="PORTA TCP" FontSize="10" Foreground="#A8B2C5" Margin="0,0,0,5"/><TextBox Text="{Binding HostPort, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Porta da sala"/></StackPanel></WrapPanel><CheckBox Content="Tentar abrir a porta no roteador automaticamente" IsChecked="{Binding AutoMapPort}" Foreground="#CFD9E6" Margin="0,9,0,0"/></StackPanel><TextBlock Text="{Binding NetworkDetails}" TextWrapping="Wrap" Foreground="#A8B2C5" FontSize="11" Margin="0,8,0,0"/><WrapPanel Margin="0,12,0,0"><Button Content="Criar sala" Command="{Binding CreateRoomCommand}" Background="#A999FF" Foreground="#1C1738" ToolTip="Criar uma sala no modo selecionado" AutomationProperties.Name="Criar sala"/><Button Content="Entrar em uma sala existente" Command="{Binding JoinRoomCommand}" ToolTip="Entrar com o código da sala" AutomationProperties.Name="Entrar em uma sala existente"/><Button Content="Copiar código da sala" Command="{Binding CopyCommand}" ToolTip="Copiar o código da sua sala" AutomationProperties.Name="Copiar código da sala"/></WrapPanel></StackPanel></Grid></Border>
      </Grid>
      <Border Grid.Row="2" Margin="24,16,24,20" Background="#1C2332" CornerRadius="12" Padding="14,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Ellipse Width="8" Height="8" Fill="#68D9B4" Margin="3,0,9,0"/><TextBlock Text="{Binding Status}" Foreground="#CFD9E6" TextTrimming="CharacterEllipsis" MaxWidth="250" AutomationProperties.Name="Estado da conexão"/></StackPanel><WrapPanel Grid.Column="1"><Button Content="◉   Compartilhar tela" Command="{Binding ShareCommand}" Background="#A999FF" Foreground="#1C1738" ToolTip="Escolha uma janela ou tela no seletor do Windows" AutomationProperties.Name="Compartilhar tela"/><Button Content="{x:Static r:Strings.Stop}" Command="{Binding StopCommand}" ToolTip="Parar o compartilhamento sem sair da sala" AutomationProperties.Name="Parar compartilhamento"/><Button Content="Sair da sala" Command="{Binding DisconnectCommand}" Background="#4A303A" Foreground="#FFB7BD" ToolTip="Sair da sala" AutomationProperties.Name="Sair da sala" Margin="0"/></WrapPanel></Grid></Border>
    </Grid>
    <Border Grid.Column="3" Background="#171C2A" BorderBrush="#292F40" BorderThickness="1,0,0,0"><Grid><Grid.RowDefinitions><RowDefinition Height="72"/><RowDefinition Height="*"/></Grid.RowDefinitions><Border BorderBrush="#2B3141" BorderThickness="0,0,0,1" Padding="19,0"><TextBlock Text="DETALHES DA SALA" FontSize="10" FontWeight="Bold" Foreground="#9AA6BA" VerticalAlignment="Center"/></Border><StackPanel Grid.Row="1" Margin="19,24,19,0"><TextBlock Text="SUA CONEXÃO" FontSize="10" FontWeight="Bold" Foreground="#77859B"/><Border Background="#252B3B" CornerRadius="10" Padding="12" Margin="0,12,0,0"><StackPanel Orientation="Horizontal"><Border Width="35" Height="35" Background="#514B89" CornerRadius="12"><TextBlock Text="G" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Margin="10,0,0,0" VerticalAlignment="Center"><TextBlock Text="Você" FontWeight="SemiBold" FontSize="12"/><TextBlock Text="{Binding RoomTitle}" FontSize="11" Foreground="#9DA9BA" Margin="0,3,0,0"/></StackPanel></StackPanel></Border><TextBlock Text="O QUE COMPARTILHAR" FontSize="10" FontWeight="Bold" Foreground="#77859B" Margin="0,30,0,12"/><Button Content="▣   Uma janela específica" Command="{Binding ShareCommand}" HorizontalContentAlignment="Left" Margin="0,0,0,8" ToolTip="No seletor do Windows, escolha a janela desejada" AutomationProperties.Name="Compartilhar uma janela específica"/><Button Content="▢   Tela inteira" Command="{Binding ShareCommand}" HorizontalContentAlignment="Left" Margin="0" ToolTip="No seletor do Windows, escolha a tela desejada" AutomationProperties.Name="Compartilhar a tela inteira"/><TextBlock Text="Escolha a janela ou a tela no seletor que será aberto." TextWrapping="Wrap" Foreground="#96A2B8" FontSize="11" LineHeight="17" Margin="0,8,0,0"/><TextBlock Text="QUALIDADE DA TRANSMISSÃO" FontSize="10" FontWeight="Bold" Foreground="#77859B" Margin="0,22,0,12"/><Border Background="#202638" CornerRadius="10" Padding="13"><StackPanel><TextBlock Text="720p  /  30 fps" FontWeight="SemiBold" Foreground="#E2E4F7"/><TextBlock Text="Escolha uma janela ou a tela inteira no seletor do Windows. A tela inteira mostra todas as janelas visíveis." TextWrapping="Wrap" Foreground="#96A2B8" FontSize="11" LineHeight="17" Margin="0,7,0,0"/></StackPanel></Border><TextBlock Text="{Binding RoomHint}" TextWrapping="Wrap" Foreground="#8490A5" FontSize="11" LineHeight="18" Margin="0,25,0,0"/></StackPanel></Grid></Border>
  </Grid>
  </ScrollViewer>
</Window>
